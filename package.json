  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0"
  }
}
