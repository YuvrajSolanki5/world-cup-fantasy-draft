{
  "name": "world-cup-fantasy-draft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --minify false",
    "preview": "vite preview --host 127.0.0.1",
